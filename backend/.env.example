# ---- Server ----
NODE_ENV=development            # development | production | test
PORT=4000
CORS_ORIGINS=http://localhost:5173   # comma-separated web origins allowed to call the API

# ---- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_DEV_ECHO=true               # MUST be false in production (server refuses to start otherwise)

# ---- First super admin (created by `npm run seed:prod` if the phone doesn't exist yet) ----
SUPER_ADMIN_PHONE=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ---- Database ----
# DB_FILE=data/ibt_aqua.sqlite
BACKUP_DIR=backups

# ---- Razorpay (leave empty in development: payments run in mock mode) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Messaging (empty = logged to console and marked "not configured") ----
SMS_PROVIDER=console            # console | msg91
SMS_API_KEY=
WHATSAPP_TOKEN=                 # Meta WhatsApp Cloud API
WHATSAPP_PHONE_ID=
SMTP_URL=
FCM_SERVER_KEY=

# ---- Files & jobs ----
UPLOAD_DIR=src/uploads
MAX_UPLOAD_MB=5
ENABLE_JOBS=true                # subscriptions, batch expiry, backups, outbox; run on ONE instance only
